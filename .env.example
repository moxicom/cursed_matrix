# cp .env.example .env, then `make secrets` — or openssl rand -hex 32 for each
# empty secret (hex, not base64: the values end up inside connection URLs).

# --- images ----------------------------------------------------------------
# Server that pulls instead of building: IMAGE_REPO=ghcr.io/moxicom/cursed_matrix
IMAGE_REPO=cursed-matrix
IMAGE_TAG=prod
# 1 = build the backend within ~512 MB instead of ~768, slower.
GO_BUILD_LOWMEM=

# "monitoring" adds VictoriaMetrics, Grafana and two exporters (~420 MB).
COMPOSE_PROFILES=monitoring

# Only exactly "production" gives the session cookies the Secure flag.
APP_ENV=production

# --- published ports (127.0.0.1 except FRONT_PORT; use 127.0.0.1:8080 behind TLS)
FRONT_PORT=8080
VITE_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
VM_PORT=8428
GRAFANA_PORT=3000

# --- memory limits ----------------------------------------------------------
# Hard cap per container (docker units: 256m, 1g). 0 = no limit. On a 1 GB host
# set them so one runaway service cannot take Postgres down with it:
#   POSTGRES_MEM_LIMIT=256m BACK_MEM_LIMIT=256m REDIS_MEM_LIMIT=96m FRONT_MEM_LIMIT=32m
POSTGRES_MEM_LIMIT=0
BACK_MEM_LIMIT=0
REDIS_MEM_LIMIT=0
FRONT_MEM_LIMIT=0
# Go runtime soft heap ceiling for the API (e.g. 192MiB); empty = off.
# Set it below BACK_MEM_LIMIT so the GC tightens before the cgroup OOM-kills.
BACK_GOMEMLIMIT=

# --- postgres --------------------------------------------------------------
POSTGRES_USER=cursed
POSTGRES_DB=cursed_matrix
POSTGRES_PASSWORD=

# --- redis -----------------------------------------------------------------
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# --- backend ---------------------------------------------------------------
# Rotating JWT_SECRET signs everyone out.
JWT_SECRET=

# --- monitoring ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
VM_RETENTION=15d
VM_MEMORY_PERCENT=40
