# Copy to .env and change every password before the first `docker compose up`.
#
#   cp .env.example .env
#
# Compose refuses to start without POSTGRES_PASSWORD, REDIS_PASSWORD,
# JWT_SECRET and GRAFANA_ADMIN_PASSWORD — that is deliberate. A default
# password that works is a default password that ships.
#
# Generate each one with:  openssl rand -hex 32
#
# Hex, not base64: POSTGRES_PASSWORD and REDIS_PASSWORD are substituted into
# connection URLs (postgres://user:PASSWORD@host), where a '/' or '+' from
# `openssl rand -base64` silently breaks the URL parse.

# --- images ----------------------------------------------------------------
IMAGE_TAG=dev

# Which deployment this is. Anything other than exactly "production" is
# treated as development, and in development the session cookies are issued
# WITHOUT the Secure flag — a browser will then send them over plain HTTP.
# A server that serves the site over HTTPS must set this to production.
APP_ENV=development

# --- published ports (all bound to 127.0.0.1 except FRONT_PORT) ------------
# FRONT_PORT is published on every interface. On a server with a TLS
# terminator in front of it, bind it to the loopback instead so the plain-HTTP
# port is not reachable from the network:
#
#   FRONT_PORT=127.0.0.1:8080
#
FRONT_PORT=8080
VITE_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
VM_PORT=8428
GRAFANA_PORT=3000

# --- postgres --------------------------------------------------------------
POSTGRES_USER=cursed
POSTGRES_DB=cursed_matrix
POSTGRES_PASSWORD=

# --- redis -----------------------------------------------------------------
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# --- backend ---------------------------------------------------------------
# Secrets the backend reads. Which variable holds which credential is declared
# in back/config/config.yaml (the *_key fields), so these names are data, not
# code. Rotating JWT_SECRET invalidates every token in flight.
JWT_SECRET=

# --- monitoring ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
VM_RETENTION=15d
# Share of host memory VictoriaMetrics may use for caches.
VM_MEMORY_PERCENT=40
