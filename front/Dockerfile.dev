# syntax=docker/dockerfile:1
#
# Development image: the Vite dev server with HMR, used by
# docker-compose.dev.yml. Source is bind-mounted over /app at run time, so this
# image only has to carry the dependencies.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

EXPOSE 5173

# --host binds 0.0.0.0: without it Vite listens on loopback inside the
# container and the published port answers nothing.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
