# nginx site config for the built SPA: history fallback + same-origin /api proxy.

# Cache-Control via a map so every add_header stays at server level:
# an add_header inside a location would drop all inherited headers.
map $uri $cursed_cache_control {
    default        "no-cache, must-revalidate";
    ~^/assets/     "public, max-age=31536000, immutable";
    ~^/api(/|$)    "";
}

log_format cursed_api '$remote_addr $request_method $uri$is_args$args '
                      'status=$status bytes=$body_bytes_sent '
                      'request_time=$request_time upstream_time=$upstream_response_time '
                      'id=$upstream_http_x_request_id';

# HSTS only once a TLS terminator forwards X-Forwarded-Proto: https.
map $http_x_forwarded_proto $cursed_hsts {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

# --- rate limits: the edge stops volume, the backend counts per account ------
# Empty key = not counted, so the strict zone only applies to credential endpoints.
map $uri $cursed_auth_key {
    default                                   "";
    ~^/api/v1/auth/(register|login|refresh)$  $binary_remote_addr;
}

limit_req_zone  $binary_remote_addr  zone=cursed_api:10m   rate=20r/s;
limit_req_zone  $cursed_auth_key     zone=cursed_auth:10m  rate=20r/m;
limit_conn_zone $binary_remote_addr  zone=cursed_conn:10m;

limit_req_status  429;
limit_conn_status 429;

server {
    listen      8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Docker DNS; the backend is resolved per request, see /api/.
    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 1m;
    limit_conn cursed_conn 48;

    server_tokens off;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/manifest+json;

    # Google Fonts allowed because index.html loads JetBrains Mono from the CDN.
    add_header X-Content-Type-Options  "nosniff"     always;
    add_header X-Frame-Options         "DENY"        always;
    add_header Referrer-Policy         "same-origin" always;
    add_header Permissions-Policy      "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control           $cursed_cache_control always;
    add_header Strict-Transport-Security $cursed_hsts always;

    # Answered by nginx itself, so the container stays healthy while the API is down.
    location = /healthz {
        access_log   off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # No API root; without this /api would fall through to index.html.
    location = /api {
        return 404;
    }

    # Host in a variable: nginx then boots even while the backend is down.
    location /api/ {
        limit_req zone=cursed_api  burst=40 nodelay;
        limit_req zone=cursed_auth burst=10 nodelay;

        # Above the 16 KiB the backend reads, so the oversized-body error is the app's.
        client_max_body_size 64k;

        access_log /var/log/nginx/access.log cursed_api;

        set $backend "${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_pass http://$backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    # A missing fingerprinted file is a deploy error, not a route.
    location /assets/ {
        access_log off;
        try_files  $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
