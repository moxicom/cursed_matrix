          "expr": "sum by (datname) (rate(pg_stat_database_deadlocks{datname!~\"template.*|postgres\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
